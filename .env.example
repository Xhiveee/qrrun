# --- Публичный адрес, который зашивается в QR-коды ---
# Например: https://event.example.com
PUBLIC_URL=http://localhost:3000

# --- Домен и email для Let's Encrypt (используются install.sh / docker compose) ---
DOMAIN=localhost
LETSENCRYPT_EMAIL=admin@example.com
ENABLE_TLS=false

# --- Сервер ---
PORT=3000
DATABASE_PATH=/data/qrush.sqlite

# --- Секреты (ОБЯЗАТЕЛЬНО поменять) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Учётка администратора (создаётся при первом запуске) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
